# MathQuest Environment Template

# Web Service (apps/web)
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://mathquest.mainuddintalukdar.cloud
PORT=3000

# Supabase (Cloud Project or Local Test Instance)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Internal Scoring Microservice Communication
SCORING_SERVICE_URL=http://mathquest-scoring:8005
INTERNAL_SERVICE_TOKEN=change-me-to-a-secure-random-token-min-32-chars

# Scoring Microservice (services/scoring)
PORT=8005
HOST=0.0.0.0
ALLOWED_HOSTS=*
